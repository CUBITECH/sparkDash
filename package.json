{
  "name": "sparkdash",
  "version": "1.8.5",
  "description": "sparkDash — Multi-DGX Spark Monitoring Dashboard",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test server/collectors/__tests__/*.test.js server/sparks/__tests__/*.test.js server/status/__tests__/*.test.js",
    "verify:pwa": "node scripts/verify-pwa.mjs",
    "test:windows-desktop-tile": "dotnet test platforms/windows/SparkDashDesktopTile/SparkDash.StatusCore.Tests/SparkDash.StatusCore.Tests.csproj --configuration Release -p:RestoreLockedMode=true && dotnet test platforms/windows/SparkDashDesktopTile/SparkDash.DesktopTile.Tests/SparkDash.DesktopTile.Tests.csproj --configuration Release -p:RestoreLockedMode=true",
    "build:windows-desktop-tile": "dotnet build platforms/windows/SparkDashDesktopTile/SparkDash.DesktopTile/SparkDash.DesktopTile.csproj --configuration Release -p:Platform=x64 -p:RestoreLockedMode=true",
    "verify:windows-desktop-tile": "node scripts/verify-windows-desktop-tile.mjs",
    "install:windows-desktop-tile": "powershell -ExecutionPolicy Bypass -File platforms/windows/SparkDashDesktopTile/tools/install_desktop_tile.ps1",
    "verify:macos-companion": "node scripts/verify-macos-companion.mjs",
    "verify:platform-companions": "npm run build && npm run verify:pwa && npm run verify:windows-desktop-tile && npm run verify:macos-companion",
    "preview": "vite preview",
    "start": "node server/index.js",
    "docker:up": "docker compose up -d",
    "docker:dev": "docker compose -f docker-compose.dev.yml up",
    "docker:dev:build": "docker compose -f docker-compose.dev.yml up --build",
    "docker:prod": "docker compose up -d",
    "docker:rebuild": "docker compose up --build -d",
    "frontend": "npm run build"
  },
  "keywords": [
    "nvidia",
    "dgx-spark",
    "gb10",
    "monitoring",
    "dashboard",
    "gpu",
    "llm"
  ],
  "author": "Mia'a AI Lab",
  "homepage": "https://x.com/MiaAI_lab",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tailwindcss/vite": "^4.3.2",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "concurrently": "^10.0.3",
    "postcss": "^8.5.19",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vite-plugin-pwa": "^1.3.0"
  }
}
