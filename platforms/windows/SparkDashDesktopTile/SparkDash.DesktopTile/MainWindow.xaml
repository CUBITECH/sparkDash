<Window x:Class="SparkDash.DesktopTile.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="sparkDash Desktop Tile"
        Width="420"
        Height="280"
        MinWidth="320"
        MinHeight="180"
        MaxWidth="900"
        MaxHeight="700"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="Background" Value="#263140" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#354457" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#16202C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#F21A1F2A"
            BorderBrush="#405064"
            BorderThickness="1"
            CornerRadius="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              ShadowDepth="5"
                              Opacity="0.42"
                              Color="#000000" />
        </Border.Effect>
        <Grid Margin="16,10,16,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="36" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0"
                      Background="Transparent"
                      Cursor="SizeAll"
                      MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="9"
                                 Height="9"
                                 Margin="0,0,9,0"
                                 Fill="{Binding StateBrush}" />
                        <TextBlock Text="{Binding Title}"
                                   Foreground="#F8FAFC"
                                   FontFamily="Segoe UI Variable Display"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="TopmostButton"
                            Width="44"
                            Height="28"
                            Margin="0,0,6,0"
                            Content="PIN"
                            ToolTip="Toggle always on top"
                            AutomationProperties.Name="Toggle always on top"
                            Click="TopmostButton_Click"
                            Style="{StaticResource ChromeButton}" />
                    <Button Width="30"
                            Height="28"
                            Content="—"
                            ToolTip="Hide to tray"
                            AutomationProperties.Name="Hide to tray"
                            Click="HideButton_Click"
                            Style="{StaticResource ChromeButton}" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,2,0,7">
                <TextBlock Text="{Binding Headline}"
                           Foreground="#F8FAFC"
                           FontFamily="Segoe UI Variable Display"
                           FontSize="20"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding StatusText}"
                           Foreground="#94A3B8"
                           FontFamily="Segoe UI Variable Text"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <ItemsControl Grid.Row="2"
                          ItemsSource="{Binding Units}"
                          HorizontalContentAlignment="Stretch">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,6"
                                Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                HorizontalAlignment="Stretch"
                                ClipToBounds="True"
                                Padding="10,6"
                                Background="#9B252D3A"
                                CornerRadius="10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ThermalThrottle}" Value="True">
                                            <Setter Property="BorderBrush" Value="#EF4444" />
                                            <Setter Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.7*" MinWidth="120" />
                                    <ColumnDefinition Width="*" MinWidth="48" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Name}"
                                           Foreground="#F1F5F9"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           Margin="0,2,0,0"
                                           Text="{Binding MetricsText}"
                                           Foreground="#CBD5E1"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis" />
                                <Grid Grid.Row="2" Grid.Column="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding LlmText}"
                                               Foreground="#7DD3FC"
                                               FontSize="10"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1"
                                               Margin="5,0,0,0"
                                               Text="{Binding ModelText}"
                                               Foreground="#C4B5FD"
                                               FontSize="9"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding ModelText}" />
                                </Grid>
                                <Border Grid.Column="1"
                                        Grid.RowSpan="3"
                                        MinWidth="48"
                                        Height="34"
                                        Margin="8,0"
                                        Padding="3,1"
                                        VerticalAlignment="Center"
                                        Background="#52141C27"
                                        CornerRadius="6"
                                        ToolTip="{Binding LlmText}"
                                        AutomationProperties.Name="Generation tokens per second graph">
                                    <Grid>
                                        <TextBlock Text="GEN TOK/S"
                                                   Margin="0,0,2,0"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Top"
                                                   Foreground="#64748B"
                                                   FontSize="7"
                                                   FontWeight="SemiBold"
                                                   IsHitTestVisible="False" />
                                        <Viewbox Margin="0,7,0,0"
                                                 Stretch="Fill"
                                                 StretchDirection="Both">
                                            <Canvas Width="120" Height="32" ClipToBounds="True">
                                                <Line X1="0"
                                                      Y1="31"
                                                      X2="120"
                                                      Y2="31"
                                                      Stroke="#405064"
                                                      StrokeThickness="1" />
                                                <Polyline Points="{Binding GenerationPoints}"
                                                          Stroke="#38BDF8"
                                                          StrokeThickness="2"
                                                          StrokeLineJoin="Round"
                                                          Opacity="{Binding GenerationOpacity}"
                                                          SnapsToDevicePixels="True" />
                                            </Canvas>
                                        </Viewbox>
                                    </Grid>
                                </Border>
                                <TextBlock Grid.Column="2"
                                           Grid.RowSpan="3"
                                           Text="{Binding StatusText}"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#4ADE80" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Online}" Value="False">
                                                    <Setter Property="Foreground" Value="#F87171" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Grid.Row="3" Margin="0,0,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding LastUpdatedText}"
                           Foreground="#94A3B8"
                           FontSize="10"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Height="28"
                        MinWidth="112"
                        Content="Open sparkDash"
                        AutomationProperties.Name="Open sparkDash dashboard"
                        Click="OpenDashboard_Click"
                        Style="{StaticResource ChromeButton}" />
            </Grid>

            <Thumb x:Name="ResizeGrip"
                   Grid.RowSpan="4"
                   Width="18"
                   Height="18"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Cursor="SizeNWSE"
                   DragDelta="ResizeGrip_DragDelta"
                   DragCompleted="ResizeGrip_DragCompleted">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <TextBlock Text="◢"
                                   Foreground="#64748B"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</Window>
